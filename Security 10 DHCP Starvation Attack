# DHCP starvation = a flood of DISCOVERs from spoofed MACs to drain the pool.
# Rate-limits it, logs the flood (DHCP-FLOOD) so you see it, and turns on
# conflict-detection. The real fix on a managed network is authenticated leases
# (RADIUS, or MAC-bound static leases) - a rate limit cannot tell an attacker's
# MAC from a real one. Change 30,20 if a big network floods on power-up.
/ip firewall filter
add chain=input action=accept protocol=udp dst-port=67 limit=30,20
add chain=input action=drop protocol=udp dst-port=67 log=yes log-prefix="DHCP-FLOOD"

# Only fires if the DHCP server sits on a bridge; harmless otherwise.
/interface bridge filter
add chain=input action=accept mac-protocol=ip ip-protocol=udp dst-port=67 limit=30,20
add chain=input action=drop mac-protocol=ip ip-protocol=udp dst-port=67 log=yes log-prefix="DHCP-FLOOD"

/ip dhcp-server set [find] conflict-detection=yes
