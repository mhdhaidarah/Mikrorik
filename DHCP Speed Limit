# Paste in Terminal. Applies to every DHCP server on the router.
# Change 2M/2M below for a different speed (upload/download).
:local speed "2M/2M"
/ip dhcp-server set [find] lease-script="\
:local q (\"dhcp-\" . \$leaseActMAC)\r\
\n:if (\$leaseBound = 1) do={\r\
\n  /queue simple remove [find name=\$q]\r\
\n  /queue simple add name=\$q target=(\$leaseActIP . \"/32\") max-limit=$speed comment=dhcp-speed-limit\r\
\n} else={\r\
\n  /queue simple remove [find name=\$q]\r\
\n}"
